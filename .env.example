# Copy to .env and fill in. .env is gitignored; on a shared host: chmod 600 .env

# --- Generation (the only outbound API call this system makes) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
RAG_CLAUDE_MODEL=claude-opus-5
RAG_MAX_TOKENS=16000
# Server-side refusal fallbacks are a first-party Claude API feature.
# Set to false when pointing at Bedrock, Vertex or Foundry.
RAG_ENABLE_REFUSAL_FALLBACK=true

# --- Vector store ---
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
RAG_COLLECTION=documents

# --- Embeddings (local; nothing leaves the host for this step) ---
RAG_EMBED_MODEL=BAAI/bge-base-en-v1.5
RAG_EMBED_DIM=768
RAG_EMBED_BATCH_SIZE=64

# --- Chunking (re-ingest after changing these, then re-run the eval) ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=75

# --- Retrieval ---
RAG_TOP_K=5
# RAG_SCORE_THRESHOLD=0.35

# --- API ---
# Unset means /query is open to anyone who can reach the port. Set it before
# anyone else on the network uses this, and before it indexes client data.
# RAG_API_KEY=generate-with-openssl-rand-hex-32
RAG_LOG_LEVEL=INFO
RAG_LOG_ANSWERS=false
